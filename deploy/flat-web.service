[Unit]
Description=Flat Web local household service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jacksn/flat
EnvironmentFile=/srv/app-data/flat/flat.env
Environment=PATH=/home/jacksn/.local/bin:/home/jacksn/.bun/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/jacksn/.bun/bin/bun server/index.ts
Restart=on-failure
RestartSec=3
UMask=0077
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=default.target
