{
  "name": "flat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch server/index.ts --api-only",
    "dev:client": "vite dev --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "start": "bun run build && bun server/index.ts",
    "serve": "bun server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts && bun test server/db.bun.test.ts server/app.bun.test.ts server/codex.bun.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "bun server/migrate.ts",
    "import:receipts": "bun scripts/import-receipts.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "hono": "^4.12.19",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
