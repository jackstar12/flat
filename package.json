{
  "name": "flat-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "bun run build && vite preview --host 0.0.0.0",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply flat-web --local",
    "db:migrate:remote": "wrangler d1 migrations apply flat-web --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "hono": "^4.12.19",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260517.0",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "@playwright/test": "^1.60.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9",
    "wrangler": "^4.92.0"
  }
}
